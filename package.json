{
  "name": "ranledger",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src server api e2e scripts vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write src server api e2e scripts *.ts *.json index.html public/icon.svg",
    "format:check": "prettier --check src server api e2e scripts *.ts *.json index.html public/icon.svg"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@electric-sql/pglite": "0.5.10",
    "@hono/node-server": "2.1.5",
    "@radix-ui/react-select": "^2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "lucide-react": "1.58.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-day-picker": "10.0.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
