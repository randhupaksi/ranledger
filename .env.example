# Local API works without DATABASE_URL using .cache/server-data
# Production requires a persistent PostgreSQL database and the public app origin
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ranledger?sslmode=require
APP_ORIGIN=http://localhost:5173
PORT=8787
HOST=127.0.0.1
# Set TRUST_PROXY=1 only behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY=0
